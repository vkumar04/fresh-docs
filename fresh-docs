#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""
fresh-docs — pull authoritative, version-current library docs.

Single-file CLI, stdlib-only. The PEP 723 metadata block above lets `uv`
launch this script directly via the shebang — no `pip install` needed.

Install:
  # Shebang + uv. Pin to a known-good revision in CI if you want stability.
  curl -fsSL https://raw.githubusercontent.com/vkumar04/fresh-docs/main/fresh-docs \
    -o ~/.local/bin/fresh-docs && chmod +x ~/.local/bin/fresh-docs

Subcommands:
  llms <library> [--grep <pat>]    raw llms.txt fetch (no LLM pre-summary)
  page <url>                       browser-UA HTTP GET + HTML strip
  diff <library> <from> <to>       GH release notes between two semver tags
  audit [--since <ref>]            package.json bump report since a commit
  check-map                        HEAD-check every URL in LLMS_URL_MAP

Exit codes:
  0   success
  1   bad input / unresolved library / breaking bumps found (--flag-breaking-only)
  2   HTTP non-200 from upstream / dead map entries (check-map)
  3   subprocess failed (npm / gh)
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from urllib.error import HTTPError
from urllib.parse import urljoin
from urllib.request import Request, urlopen

UA = "Mozilla/5.0 (compatible; fresh-docs/1.0)"
TIMEOUT_S = 15

# Verified 2026-05-25 via HEAD requests. Patch entries that flip to 404.
# Mapped by both npm-package name AND tool name where they differ — so
# `fresh-docs llms uv` and `fresh-docs llms @tanstack/react-query` both work.
LLMS_URL_MAP: dict[str, str] = {
    # JS/TS ecosystem
    "ai": "https://ai-sdk.dev/llms.txt",
    "@ai-sdk/react": "https://ai-sdk.dev/llms.txt",
    "@ai-sdk/anthropic": "https://ai-sdk.dev/llms.txt",
    "next": "https://nextjs.org/docs/llms.txt",
    "react": "https://react.dev/llms.txt",
    "@tanstack/react-query": "https://tanstack.com/llms.txt",
    "@tanstack/react-table": "https://tanstack.com/llms.txt",
    "prisma": "https://prisma.io/llms.txt",
    "@prisma/client": "https://prisma.io/llms.txt",
    "better-auth": "https://better-auth.com/llms.txt",
    "zod": "https://zod.dev/llms.txt",
    "shadcn": "https://ui.shadcn.com/llms.txt",
    "shadcn-ui": "https://ui.shadcn.com/llms.txt",
    "vercel": "https://vercel.com/docs/llms.txt",
    "vitest": "https://vitest.dev/llms.txt",
    "stripe": "https://docs.stripe.com/llms.txt",
    "resend": "https://resend.com/llms.txt",
    # Python ecosystem (so `uv view` style lookups can't poison this)
    "uv": "https://docs.astral.sh/uv/llms.txt",
    "ruff": "https://docs.astral.sh/ruff/llms.txt",
    # Elixir ecosystem — recent ExDoc emits llms.txt on HexDocs, so most
    # packages get one for free (usually index-format: drill in with
    # --subpage). Content-verified 2026-07-08: hexdocs.pm serves an HTML
    # fallback page with a 200 for missing files, so a status check alone
    # lies. phoenix and oban have NO real llms.txt as of 2026-07-08 — use
    # `fresh-docs page https://hexdocs.pm/<pkg>/<page>.html` for those.
    "elixir": "https://hexdocs.pm/elixir/llms.txt",
    "ecto": "https://hexdocs.pm/ecto/llms.txt",
    "ash": "https://hexdocs.pm/ash/llms.txt",
    "phoenix_live_view": "https://hexdocs.pm/phoenix_live_view/llms.txt",
}

# When llms.txt is the "index" format (a list of `[title](url.md)` links
# pointing at clean-markdown subpages), pass --subpage <regex> to drill in.
# Links may be absolute (uv, Vercel) or relative (HexDocs: `bindings.md`) —
# relative ones get resolved against the llms.txt URL at fetch time.
_MD_LINK_RE = re.compile(r"\[([^\]]+)\]\(([^)\s]+\.md)\)")


def http_get(url: str) -> str:
    """GET a URL with a real UA. Raises HTTPError on non-2xx."""
    req = Request(
        url,
        headers={
            "User-Agent": UA,
            "Accept": "text/plain, text/markdown, text/html;q=0.8, */*;q=0.5",
        },
    )
    with urlopen(req, timeout=TIMEOUT_S) as resp:
        return resp.read().decode("utf-8", errors="replace")


def run(argv: list[str], timeout: int = 15) -> tuple[str, str]:
    """Run a subprocess, return (stdout, stderr). stdout is "" on failure,
    and stderr carries the diagnostic so callers can surface real errors
    ("gh: Not logged in") instead of guessing."""
    try:
        proc = subprocess.run(
            argv, text=True, capture_output=True, timeout=timeout, check=False
        )
    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
        return "", str(e)
    if proc.returncode != 0:
        return "", (proc.stderr or "").strip()
    return proc.stdout.strip(), (proc.stderr or "").strip()


def npm_view(package: str, field: str) -> str:
    """`npm view <pkg> <field>`, trying npm directly before `bunx npm` so a
    machine with only one of the two launchers still resolves."""
    for argv in (
        ["npm", "view", package, field],
        ["bunx", "npm", "view", package, field],
    ):
        out, _ = run(argv)
        if out:
            return out
    return ""


def _pypi_urls(package: str) -> list[str]:
    """Candidate docs/homepage/repo URLs from the PyPI JSON API ([] on any
    failure). Lets `llms`/`diff` resolve Python packages, not just npm ones."""
    try:
        raw = http_get(f"https://pypi.org/pypi/{package}/json")
        info = json.loads(raw).get("info") or {}
    except (OSError, ValueError):
        return []
    links = info.get("project_urls") or {}
    # Documentation-style links first — that's where llms.txt lives.
    urls = [v for k, v in links.items() if "doc" in k.lower()]
    urls.append(info.get("home_page"))
    urls += [v for k, v in links.items() if "doc" not in k.lower()]
    return [u for u in urls if u]


def _hex_urls(package: str) -> list[str]:
    """Candidate docs/repo URLs from the hex.pm API ([] on any failure) —
    Elixir/Erlang packages resolve through Hex + HexDocs, not npm/PyPI."""
    try:
        raw = http_get(f"https://hex.pm/api/packages/{package}")
        pkg = json.loads(raw)
    except (OSError, ValueError):
        return []
    # docs_html_url may be a custom subdomain (phoenix.hexdocs.pm); the
    # canonical hexdocs.pm/<pkg> path usually works too, so try both.
    urls = [pkg.get("docs_html_url"), f"https://hexdocs.pm/{package}"]
    urls += list(((pkg.get("meta") or {}).get("links") or {}).values())
    return [u for u in urls if u]


def _looks_like_html(text: str) -> bool:
    return text.lstrip()[:15].lower().startswith(("<!doctype", "<html"))


def _url_alive(url: str) -> bool:
    """HEAD-check with GET fallback for servers that reject or hang on HEAD.
    A 2xx with a text/html content-type counts as DEAD: hexdocs.pm serves an
    HTML fallback page with status 200 for missing llms.txt files."""
    for method in ("HEAD", "GET"):
        try:
            req = Request(url, headers={"User-Agent": UA}, method=method)
            with urlopen(req, timeout=TIMEOUT_S) as resp:
                if not 200 <= resp.status < 400:
                    return False
                ctype = (resp.headers.get("Content-Type") or "").lower()
                return "text/html" not in ctype
        except HTTPError as e:
            if method == "HEAD" and e.code in (403, 405):
                continue
            return False
        except OSError:
            if method == "HEAD":
                continue
            return False
    return False


# ── llms subcommand ────────────────────────────────────────────────


def _autodiscover_llms_url(library: str) -> str | None:
    """
    Conservative auto-discovery via `npm view <lib> homepage`, then PyPI
    project URLs, then hex.pm (Elixir).

    Defensive twice over: dogfooding revealed that `npm view uv homepage`
    returns a homepage for `github.com/micnic/uv` (a random JS package),
    which is NOT the tool the user meant — so a candidate URL must
    reference the library name. And a name-collided candidate (npm's
    `ecto` vs Elixir's) usually has no llms.txt, so each candidate is
    liveness-checked and the first one actually serving llms.txt wins.
    """
    # Library name must appear somewhere in the URL host or path. Scoped
    # packages like @tanstack/react-query → strip the leading "@<scope>/".
    bare = library.split("/")[-1].lower()
    candidates: list[str] = []
    homepage = npm_view(library, "homepage")
    if homepage:
        candidates.append(homepage)
    candidates += _pypi_urls(library)
    candidates += _hex_urls(library)
    for cand in candidates:
        if bare not in cand.lower():
            continue
        url = cand.rstrip("/") + "/llms.txt"
        if _url_alive(url):
            return url
    return None


def cmd_llms(args: argparse.Namespace) -> int:
    url = LLMS_URL_MAP.get(args.library) or _autodiscover_llms_url(args.library)
    if not url:
        print(
            f"fresh-docs: no llms.txt URL for '{args.library}' "
            "(not in map, and no npm/PyPI/Hex homepage serving llms.txt). "
            "Add it to LLMS_URL_MAP or try `fresh-docs page <docs-url>`.",
            file=sys.stderr,
        )
        return 1

    try:
        content = http_get(url)
    except HTTPError as e:
        print(f"fresh-docs: HTTP {e.code} from {url}", file=sys.stderr)
        return 2
    except OSError as e:
        print(f"fresh-docs: network error fetching {url}: {e}", file=sys.stderr)
        return 2

    # If --subpage <regex>, look for index-format links and drill into the
    # FIRST matching subpage. uv/Vercel docs use this pattern: the top-level
    # llms.txt is an index of `[Title](https://.../index.md)` links.
    if args.subpage:
        sub_re = re.compile(args.subpage, re.IGNORECASE)
        for label, link in _MD_LINK_RE.findall(content):
            if sub_re.search(label) or sub_re.search(link):
                suburl = urljoin(url, link)
                try:
                    content = http_get(suburl)
                    url = suburl
                    break
                except OSError as e:
                    print(
                        f"fresh-docs: subpage fetch failed for {suburl}: {e}",
                        file=sys.stderr,
                    )
                    return 2
        else:
            print(
                f"fresh-docs: no subpage in {url} matched /{args.subpage}/i",
                file=sys.stderr,
            )
            return 1

    if _looks_like_html(content):
        print(
            f"fresh-docs: {url} returned an HTML page, not text/markdown "
            "(some hosts, e.g. hexdocs.pm, serve a 200 fallback page for "
            "missing files). Try `fresh-docs page <docs-url>` instead.",
            file=sys.stderr,
        )
        return 2

    if not args.grep:
        print(content)
        return 0

    # Extract ±2 / +20 line windows around each grep match. Coalesce adjacent
    # windows so we don't repeat lines, and insert "…" markers between gaps.
    pattern = re.compile(args.grep, re.IGNORECASE)
    lines = content.splitlines()
    blocks: list[str] = []
    last_hi = -1
    any_match = False
    for i, line in enumerate(lines):
        if pattern.search(line):
            any_match = True
            lo = max(last_hi + 1, i - 2)
            hi = min(len(lines), i + 21)
            if lo > last_hi + 1 and blocks:
                blocks.append("…")
            blocks.extend(lines[lo:hi])
            last_hi = hi - 1
    if not any_match:
        hint = ""
        if not args.subpage and _MD_LINK_RE.search(content):
            hint = (
                " — this llms.txt looks like an index of subpage links; "
                f"try `--subpage '{args.grep}'` or `--subpage <page-name>` "
                "to drill in first"
            )
        print(f"fresh-docs: no match for /{args.grep}/i in {url}{hint}", file=sys.stderr)
        return 1
    print(f"# matches for /{args.grep}/i in {url}\n")
    print("\n".join(blocks))
    return 0


# ── page subcommand ────────────────────────────────────────────────

_SCRIPT_RE = re.compile(r"<script[\s\S]*?</script>", re.IGNORECASE)
_STYLE_RE = re.compile(r"<style[\s\S]*?</style>", re.IGNORECASE)
_TAG_RE = re.compile(r"<[^>]+>")
_WS_RE = re.compile(r"\n\s*\n\s*\n+")


def cmd_page(args: argparse.Namespace) -> int:
    import html as _html  # stdlib; decode entities like &lt; → <

    try:
        content = http_get(args.url)
    except HTTPError as e:
        print(f"fresh-docs: HTTP {e.code} from {args.url}", file=sys.stderr)
        return 2
    except OSError as e:
        print(f"fresh-docs: network error fetching {args.url}: {e}", file=sys.stderr)
        return 2

    text = _SCRIPT_RE.sub("", content)
    text = _STYLE_RE.sub("", text)
    text = _TAG_RE.sub("", text)
    text = _html.unescape(text)  # &lt; → <, &amp; → &, &#x27; → ', etc.
    text = _WS_RE.sub("\n\n", text).strip()
    print(text)
    return 0


# ── diff subcommand ───────────────────────────────────────────────

# Matches three real-world tag conventions:
#   - "v6.0.191"             single-package repo, `v` prefix
#   - "6.0.191"              single-package repo, bare semver
#   - "ai@6.0.191"           Changesets monorepo (vercel/ai, tanstack/query)
#   - "@ai-sdk/anthropic@3.0.79"  scoped monorepo package
# The optional non-capturing prefix `(?:\S+@)?` is greedy, so it swallows
# everything up to the LAST `@` before the version — both `pkg@1.2.3` and
# `@scope/pkg@1.2.3` work. Build metadata (`+sha`) is ignored per semver.
_SEMVER_RE = re.compile(
    r"^(?:\S+@)?v?(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z.-]+))?(?:\+\S*)?$"
)


def parse_semver(s: str) -> tuple[int, int, int, tuple[str, ...]] | None:
    """Comparable tuple from a semver string, or None on bad input.

    Accepts both single-package tags (`v1.2.3`, `1.2.3`) and Changesets-
    monorepo tags (`pkg@1.2.3`, `@scope/pkg@1.2.3`).
    """
    m = _SEMVER_RE.match(s.strip())
    if not m:
        return None
    maj, minor, patch, pre = m.groups()
    # Pre-releases sort BEFORE releases at the same maj.min.patch. Use "~"
    # (sorts late ASCII) as the tiebreaker for non-pre versions.
    pre_key: tuple[str, ...] = (pre,) if pre else ("~",)
    return (int(maj), int(minor), int(patch), pre_key)


def tag_matches_library(tag: str, library: str) -> bool:
    """
    For monorepo tags like `ai@6.0.191` or `@ai-sdk/anthropic@3.0.79`,
    confirm the tag is FOR our library. Single-package tags (`v6.0.191`,
    `6.0.191`) always pass — they're unambiguous.
    """
    if "@" not in tag.lstrip("v").lstrip("@"):
        return True  # `v6.0.191`, `6.0.191`, or `@scope/pkg` without a version
    # tag has a `pkg@` prefix; check it matches `library`. Compare with both
    # scope-stripped and full forms, since the user might pass either.
    prefix = tag.rsplit("@", 1)[0]
    return prefix == library or prefix.lstrip("@") == library.lstrip("@")


_GITHUB_RE = re.compile(r"github\.com[:/]([^/]+/[^/.]+?)(?:\.git)?(?:/|$)")


def resolve_github_repo(library: str, ecosystem: str = "auto") -> str | None:
    """Resolve <owner>/<repo> from a package registry. `auto` tries npm,
    then PyPI, then hex.pm; pass an explicit ecosystem when the name is
    claimed in several registries (npm's `ecto` vs Elixir's `ecto`)."""
    if ecosystem in ("auto", "npm"):
        url = npm_view(library, "repository.url")
        m = _GITHUB_RE.search(url) if url else None
        if m:
            return m.group(1)
    for eco, source in (("pypi", _pypi_urls), ("hex", _hex_urls)):
        if ecosystem not in ("auto", eco):
            continue
        for cand in source(library):
            m = _GITHUB_RE.search(cand)
            if m:
                return m.group(1)
    return None


# "Breaking …" headings in any casing/emoji decoration, PLUS Changesets-style
# "### Major Changes" — Changesets repos (vercel/ai, TanStack) never write a
# literal "Breaking" heading; their breaking changes land under "Major Changes".
_BREAKING_BLOCK_RE = re.compile(
    r"(?m)^(#{1,4})\s*[^\w\n]*\b(?:breaking|major changes)\b[\s\S]*?(?=^#{1,4}\s|\Z)",
    re.IGNORECASE,
)


def _changelog_at_tag(owner_repo: str, version: str) -> dict | None:
    """Raw CHANGELOG.md at the version tag (trying `v1.2.3` then `1.2.3`).
    The fallback for repos that tag versions but never publish GitHub
    releases — common in Elixir (ecto's last GH release is v3.4.5)."""
    for tag in (f"v{version}", version):
        url = f"https://raw.githubusercontent.com/{owner_repo}/{tag}/CHANGELOG.md"
        try:
            content = http_get(url)
        except OSError:
            continue
        if content.strip() and not _looks_like_html(content):
            # Changelogs are newest-first; the head covers the recent bumps.
            return {"url": url, "content": "\n".join(content.splitlines()[:200])}
    return None


def _do_diff(
    library: str, from_version: str, to_version: str, ecosystem: str = "auto"
) -> tuple[int, dict]:
    """
    Shared core of cmd_diff. Returns (exit_code, result_dict).
    Used by both `cmd_diff` (prints to stdout) and `cmd_audit` (aggregates
    multiple diffs into one report).
    """
    result: dict = {
        "library": library,
        "from": from_version,
        "to": to_version,
        "repo": None,
        "releases": [],
        "changelog_fallback": None,
        "error": None,
    }

    owner_repo = resolve_github_repo(library, ecosystem)
    if not owner_repo:
        result["error"] = (
            f"couldn't resolve '{library}' to a GitHub repo "
            f"(ecosystem: {ecosystem})"
        )
        return 1, result
    result["repo"] = owner_repo

    from_v = parse_semver(from_version)
    to_v = parse_semver(to_version)
    if not from_v or not to_v:
        result["error"] = (
            f"invalid semver: from='{from_version}' to='{to_version}'"
        )
        return 1, result
    if from_v > to_v:
        from_v, to_v = to_v, from_v
        from_version, to_version = to_version, from_version
        result["from"], result["to"] = from_version, to_version

    raw, err = run(
        [
            "gh", "release", "list",
            "--repo", owner_repo,
            "--limit", "5000",
            "--json", "tagName,publishedAt",
        ],
        timeout=60,
    )
    if not raw:
        detail = f"gh stderr: {err[:200]}" if err else "is `gh` installed and authenticated?"
        result["error"] = (
            f"`gh release list` returned nothing for {owner_repo} ({detail})"
        )
        return 3, result

    try:
        tag_meta = json.loads(raw)
    except json.JSONDecodeError as e:
        result["error"] = f"couldn't parse gh output: {e}"
        return 3, result

    # Range is (from, to] — exclusive of `from`. The from-version is what's
    # already installed; its own release notes describe the PREVIOUS upgrade
    # and would false-flag e.g. a 6.0.0 → 6.0.1 patch bump as breaking.
    matching_tags: list[tuple[tuple, str]] = []
    for t in tag_meta:
        tag = t.get("tagName") or ""
        ver = parse_semver(tag)
        if not ver or not (from_v < ver <= to_v):
            continue
        if not tag_matches_library(tag, library):
            continue
        matching_tags.append((ver, tag))

    # `gh release list` windows to the most recent 5000 releases. A busy
    # Changesets monorepo (vercel/ai ships ~40 packages) blows past that in
    # months, silently hiding older tags — ai@6.0.0 was already outside the
    # window while ai@7.x shipped. Backfill ALL of this package's tags via
    # the refs API, prefix-filtered so the response stays small.
    if len(tag_meta) >= 4999:
        refs, _ = run(
            [
                "gh", "api", "--paginate",
                f"repos/{owner_repo}/git/matching-refs/tags/{library}@",
                "--jq", ".[].ref",
            ],
            timeout=120,
        )
        seen_tags = {tag for _, tag in matching_tags}
        for ref in refs.splitlines():
            tag = ref.removeprefix("refs/tags/")
            if tag in seen_tags:
                continue
            ver = parse_semver(tag)
            if not ver or not (from_v < ver <= to_v):
                continue
            if not tag_matches_library(tag, library):
                continue
            matching_tags.append((ver, tag))

    if not matching_tags:
        fallback = _changelog_at_tag(owner_repo, to_version)
        if fallback:
            result["changelog_fallback"] = fallback
            return 0, result
        result["error"] = (
            f"no tags in {owner_repo} match {library} between "
            f"{from_version} and {to_version} (scanned {len(tag_meta)} releases)"
        )
        return 1, result

    matching_tags.sort()

    def _release_body(tag: str) -> str:
        body, _ = run(
            ["gh", "release", "view", tag, "--repo", owner_repo, "--json", "body", "--jq", ".body"],
            timeout=15,
        )
        return body

    # A major-version range can span dozens of releases; fetch bodies in
    # parallel. 4 workers here (not 8): `audit --fetch-diffs` already runs
    # 8 _do_diff calls concurrently, so worst-case `gh` processes stay ≤ 32.
    with ThreadPoolExecutor(max_workers=min(4, len(matching_tags))) as ex:
        bodies = list(ex.map(_release_body, [tag for _, tag in matching_tags]))

    for (ver, tag), body in zip(matching_tags, bodies):
        breaking_blocks = [m.group(0).strip() for m in _BREAKING_BLOCK_RE.finditer(body or "")]
        version_str = ".".join(str(x) for x in ver[:3])
        if ver[3] != ("~",):
            version_str += "-" + ver[3][0]
        result["releases"].append({
            "tag": tag,
            "version": version_str,
            "body": body or "",
            "breaking_blocks": breaking_blocks,
        })
    return 0, result


def cmd_diff(args: argparse.Namespace) -> int:
    code, result = _do_diff(
        args.library, args.from_version, args.to_version, args.ecosystem
    )

    if args.json:
        print(json.dumps(result, indent=2))
        return code

    if result["error"]:
        print(f"fresh-docs: {result['error']}", file=sys.stderr)
        return code

    if result["changelog_fallback"]:
        fb = result["changelog_fallback"]
        print(
            f"# {result['library']}: {result['from']} → {result['to']} — "
            f"no GitHub releases in range for {result['repo']}; "
            f"CHANGELOG at the {result['to']} tag instead:\n#   {fb['url']}\n"
        )
        print(fb["content"])
        return 0

    releases = result["releases"]
    plural = "s" if len(releases) != 1 else ""
    print(
        f"# {result['library']}: {result['from']} → {result['to']} "
        f"({len(releases)} release{plural} from {result['repo']})\n"
    )
    for r in releases:
        print(f"── {r['tag']} ──")
        if r["breaking_blocks"]:
            for block in r["breaking_blocks"]:
                print(block)
                print()
        else:
            head = "\n".join(r["body"].splitlines()[:50])
            print(head if head.strip() else "(no release notes)")
        print()
    return 0


# ── audit subcommand ──────────────────────────────────────────────


def _read_package_json(path_or_ref: str) -> dict | None:
    """
    Read package.json from a file path, or from ANY git ref (branch, tag,
    HEAD^, HEAD~n, sha, origin/main, …) via `git show <ref>:package.json`.
    Existing files win the ambiguity; everything else is handed to git.
    Returns parsed JSON, or None on failure.
    """
    if os.path.isfile(path_or_ref):
        try:
            with open(path_or_ref) as f:
                return json.load(f)
        except (OSError, json.JSONDecodeError):
            return None
    raw, _ = run(["git", "show", f"{path_or_ref}:package.json"], timeout=10)
    if not raw:
        return None
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return None


def _strip_semver_prefix(v: str) -> str:
    """`^1.2.3` → `1.2.3`, `~1.2.3` → `1.2.3`, `>=1.2.3` → `1.2.3`."""
    return re.sub(r"^[\^~>=<\s]+", "", v).strip()


def _bump_type(old: str, new: str) -> str:
    """Classify a version bump: 'major', 'minor', 'patch', or 'unknown'."""
    o = parse_semver(_strip_semver_prefix(old))
    n = parse_semver(_strip_semver_prefix(new))
    if not o or not n:
        return "unknown"
    if o[0] != n[0]:
        return "major"
    if o[1] != n[1]:
        return "minor"
    if o[2] != n[2]:
        return "patch"
    return "unknown"


def cmd_audit(args: argparse.Namespace) -> int:
    """
    Diff the project's package.json against a prior commit and report what
    changed. Default: against the second-most-recent commit that touched
    package.json (i.e. "what did the last bump change?").
    """
    if args.since:
        prev_ref = args.since
    else:
        dirty, _ = run(
            ["git", "status", "--porcelain", "--", "package.json"], timeout=10
        )
        log, _ = run(
            ["git", "log", "--format=%H", "-n", "5", "--", "package.json"],
            timeout=10,
        )
        commits = [c for c in log.splitlines() if c]
        # Dirty working tree = the just-ran-`ncu -u`-and-haven't-committed
        # case: diff disk against the LAST commit. Clean tree = the bump is
        # already committed: diff against the commit BEFORE it ("what did
        # the last bump change?").
        needed = 1 if dirty else 2
        if len(commits) < needed:
            print(
                "fresh-docs: no prior package.json revision to diff against. "
                "Pass --since <ref> explicitly.",
                file=sys.stderr,
            )
            return 1
        prev_ref = commits[0] if dirty else commits[1]

    current = _read_package_json("package.json")
    if not current:
        print("fresh-docs: couldn't read ./package.json", file=sys.stderr)
        return 1
    previous = _read_package_json(prev_ref)
    if not previous:
        print(
            f"fresh-docs: couldn't read package.json at {prev_ref}",
            file=sys.stderr,
        )
        return 1

    def _all_deps(pkg: dict) -> dict[str, str]:
        return {
            **(pkg.get("dependencies") or {}),
            **(pkg.get("devDependencies") or {}),
        }

    cur_deps = _all_deps(current)
    prev_deps = _all_deps(previous)

    package_filter = (
        {p.strip() for p in args.packages.split(",") if p.strip()}
        if args.packages
        else None
    )

    added = {
        n: _strip_semver_prefix(v)
        for n, v in sorted(cur_deps.items())
        if n not in prev_deps and (not package_filter or n in package_filter)
    }
    removed = {
        n: _strip_semver_prefix(v)
        for n, v in sorted(prev_deps.items())
        if n not in cur_deps and (not package_filter or n in package_filter)
    }

    # --flag-breaking-only implicitly turns on include-patch + fetch-diffs:
    # we have to fetch every dep's release notes (including patches) to
    # detect any release with a "## Breaking" block.
    if args.flag_breaking_only:
        args.include_patch = True
        args.fetch_diffs = True

    changes: list[dict] = []
    for name, new_ver in cur_deps.items():
        old_ver = prev_deps.get(name)
        if not old_ver or old_ver == new_ver:
            continue
        old_clean = _strip_semver_prefix(old_ver)
        new_clean = _strip_semver_prefix(new_ver)
        if old_clean == new_clean:
            continue
        if package_filter and name not in package_filter:
            continue
        bump = _bump_type(old_clean, new_clean)
        if bump == "patch" and not args.include_patch:
            continue
        changes.append({
            "library": name,
            "from": old_clean,
            "to": new_clean,
            "bump_type": bump,
            "diff": None,
        })

    if args.fetch_diffs and changes:
        # Parallelize `gh` calls — each _do_diff spends most of its time
        # waiting on GitHub. 8 workers is a sweet spot: well under the
        # default 5000/hr rate limit, and most ncu -u bumps touch < 25 deps.
        # The total time becomes ceil(N/8) * (slowest dep), not N * (avg).
        worker_count = min(8, len(changes))
        with ThreadPoolExecutor(max_workers=worker_count) as ex:
            futures = {
                # package.json deps are npm by definition — skip PyPI/hex.
                ex.submit(_do_diff, c["library"], c["from"], c["to"], "npm"): c
                for c in changes
            }
            for future in as_completed(futures):
                c = futures[future]
                try:
                    _, diff_result = future.result()
                    c["diff"] = diff_result
                except Exception as e:
                    c["diff"] = {
                        "library": c["library"],
                        "from": c["from"],
                        "to": c["to"],
                        "repo": None,
                        "releases": [],
                        "error": f"worker exception: {e}",
                    }

    # --flag-breaking-only: drop any change that has zero breaking blocks
    # across all its releases. Patches that pass this gate are the rare
    # truly-risky bumps — the whole reason to scan patches in the first place.
    if args.flag_breaking_only:
        changes = [
            c for c in changes
            if c.get("diff") and any(
                r.get("breaking_blocks")
                for r in c["diff"].get("releases", [])
            )
        ]

    report = {
        "from_ref": prev_ref,
        "to_ref": "HEAD",
        "include_patch": bool(args.include_patch),
        "flag_breaking_only": bool(args.flag_breaking_only),
        "package_filter": sorted(package_filter) if package_filter else None,
        "added": added,
        "removed": removed,
        "changes": changes,
    }

    # CI-gate contract: --flag-breaking-only exits 1 when anything survives
    # the breaking filter, so pipelines can gate on exit code alone.
    exit_code = 1 if (args.flag_breaking_only and changes) else 0

    if args.json:
        print(json.dumps(report, indent=2))
        return exit_code

    if args.flag_breaking_only and not changes:
        print(
            f"fresh-docs audit: no releases with breaking-change blocks "
            f"between {prev_ref[:8]} and HEAD across "
            f"{len(cur_deps)} dependencies. All clear."
        )
        return 0
    if not changes and not added and not removed:
        kind = "non-patch changes" if not args.include_patch else "changes"
        print(
            f"fresh-docs audit: no {kind} between {prev_ref[:8]} and HEAD"
            + (" (within --packages filter)" if package_filter else "")
        )
        return 0

    total = len(changes) + len(added) + len(removed)
    print(
        f"# fresh-docs audit: {total} change"
        f"{'s' if total != 1 else ''} "
        f"from {prev_ref[:8]} → HEAD\n"
    )
    bump_counts: dict[str, int] = {}
    for c in changes:
        bump_counts[c["bump_type"]] = bump_counts.get(c["bump_type"], 0) + 1
    if bump_counts:
        summary = ", ".join(f"{n} {k}" for k, n in sorted(bump_counts.items()))
        print(f"## Summary: {summary}\n")

    by_bump: dict[str, list[dict]] = {"major": [], "minor": [], "patch": [], "unknown": []}
    for c in changes:
        by_bump.setdefault(c["bump_type"], []).append(c)
    for kind in ("major", "minor", "patch", "unknown"):
        if not by_bump[kind]:
            continue
        print(f"## {kind.title()} bumps ({len(by_bump[kind])})")
        for c in by_bump[kind]:
            line = f"  - {c['library']}: {c['from']} → {c['to']}"
            if c.get("diff") and c["diff"].get("releases"):
                rels = c["diff"]["releases"]
                breaking_count = sum(
                    len(r["breaking_blocks"]) for r in rels
                )
                line += f"  ({len(rels)} releases"
                if breaking_count:
                    line += f", {breaking_count} breaking block"
                    line += "s" if breaking_count != 1 else ""
                line += ")"
            elif c.get("diff") and c["diff"].get("error"):
                line += f"  (diff unavailable: {c['diff']['error'][:60]}…)"
            print(line)
        print()
    if added and not args.flag_breaking_only:
        print(f"## Added ({len(added)})")
        for name, ver in added.items():
            print(f"  - {name}@{ver}")
        print()
    if removed and not args.flag_breaking_only:
        print(f"## Removed ({len(removed)})")
        for name, ver in removed.items():
            print(f"  - {name}@{ver}")
        print()
    return exit_code


# ── check-map subcommand ──────────────────────────────────────────


def cmd_check_map(args: argparse.Namespace) -> int:
    """HEAD-check every URL in LLMS_URL_MAP so stale entries get caught
    before a user does. Exits 2 if any entry is dead."""
    url_to_libs: dict[str, list[str]] = {}
    for lib, url in sorted(LLMS_URL_MAP.items()):
        url_to_libs.setdefault(url, []).append(lib)

    def _status(url: str) -> tuple[str, int | str, bool]:
        def _fetch(method: str) -> tuple[int, bool]:
            req = Request(url, headers={"User-Agent": UA}, method=method)
            with urlopen(req, timeout=TIMEOUT_S) as resp:
                ctype = (resp.headers.get("Content-Type") or "").lower()
                return resp.status, "text/html" in ctype
        try:
            return (url, *_fetch("HEAD"))
        except HTTPError as e:
            if e.code not in (403, 405):  # 403/405: CDN rejects HEAD, retry GET
                return url, e.code, False
        except OSError:
            pass  # some servers hang on HEAD entirely (vercel.com); retry GET
        try:
            return (url, *_fetch("GET"))
        except HTTPError as e:
            return url, e.code, False
        except OSError as e:
            return url, f"network error: {e}", False

    all_ok = True
    with ThreadPoolExecutor(max_workers=8) as ex:
        for url, status, is_html in ex.map(_status, url_to_libs):
            ok = isinstance(status, int) and 200 <= status < 400 and not is_html
            all_ok = all_ok and ok
            mark = " ok " if ok else "DEAD"
            # A 200 that's text/html is a fallback page, not a real llms.txt
            # (hexdocs.pm does this) — flag it so the map entry gets pruned.
            note = "  [200 but text/html — fallback page?]" if (
                is_html and isinstance(status, int) and 200 <= status < 400
            ) else ""
            print(f"{mark}  {status}  {url}  ({', '.join(url_to_libs[url])}){note}")
    return 0 if all_ok else 2


# ── argparse ──────────────────────────────────────────────────────


def main() -> int:
    p = argparse.ArgumentParser(
        prog="fresh-docs",
        description="Pull authoritative, version-current library docs.",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    s_llms = sub.add_parser("llms", help="fetch llms.txt for a library (raw, no LLM summary)")
    s_llms.add_argument("library", help="e.g. 'ai', '@tanstack/react-query', 'uv'")
    s_llms.add_argument("--grep", help="extract sections matching this regex (case-insensitive)")
    s_llms.add_argument(
        "--subpage",
        help=(
            "when llms.txt is the index format (links to .md subpages), "
            "drill into the first link matching this regex"
        ),
    )
    s_llms.set_defaults(func=cmd_llms)

    s_page = sub.add_parser("page", help="fetch any docs page with a browser UA + strip HTML")
    s_page.add_argument("url")
    s_page.set_defaults(func=cmd_page)

    s_diff = sub.add_parser(
        "diff", help="release notes between two semver tags (breaking-change-aware)"
    )
    s_diff.add_argument("library", help="package name (npm, PyPI, or Hex)")
    s_diff.add_argument("from_version", metavar="from", help="e.g. 11.14.0")
    s_diff.add_argument("to_version", metavar="to", help="e.g. 12.0.0")
    s_diff.add_argument(
        "--json",
        action="store_true",
        help="emit structured output (releases, breaking_blocks) for CI / audit consumers",
    )
    s_diff.add_argument(
        "--ecosystem",
        choices=("auto", "npm", "pypi", "hex"),
        default="auto",
        help=(
            "registry to resolve the package's GitHub repo through "
            "(default: auto = npm → PyPI → hex.pm; pass explicitly when the "
            "name is claimed in several registries, e.g. `ecto`)"
        ),
    )
    s_diff.set_defaults(func=cmd_diff)

    s_audit = sub.add_parser(
        "audit",
        help=(
            "diff the project's package.json against a prior commit "
            "and report dep changes by bump type"
        ),
    )
    s_audit.add_argument(
        "--since",
        help=(
            "git ref to diff against — any branch, tag, HEAD^/HEAD~n, or sha "
            "(default: last commit touching package.json if the working tree "
            "is dirty, else the commit before it)"
        ),
    )
    s_audit.add_argument(
        "--include-patch",
        action="store_true",
        help="include patch-level bumps (default: skip — usually noise)",
    )
    s_audit.add_argument(
        "--packages",
        help="comma-separated subset of dep names to audit",
    )
    s_audit.add_argument(
        "--fetch-diffs",
        action="store_true",
        help="for each changed dep, also pull GH release notes (parallel, 8 workers)",
    )
    s_audit.add_argument(
        "--flag-breaking-only",
        action="store_true",
        help=(
            "scan ALL bumps (incl. patch) and report only those whose release "
            "notes contain a `Breaking`/`Major Changes` block — catches the "
            "rare safety-relevant patch. Implies --include-patch + "
            "--fetch-diffs. Exits 1 when any such bump is found (CI gate)."
        ),
    )
    s_audit.add_argument(
        "--json",
        action="store_true",
        help="emit structured output (changes[]) for CI consumption",
    )
    s_audit.set_defaults(func=cmd_audit)

    s_check = sub.add_parser(
        "check-map",
        help="HEAD-check every URL in the built-in llms.txt map (exit 2 on dead entries)",
    )
    s_check.set_defaults(func=cmd_check_map)

    args = p.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
